

LLM_BASE_URL="your base url"
LLM_API_KEY="dummy-api-key"
LLM_MODEL_NAME="qwen3:8b"

LANGSMITH_API_KEY="your api key"
LANGSMITH_TRACING=true
LANGSMITH_PROJECT="AUTOMATION-TESTING"


# Keep the background monitor disabled until the dry-run flow is verified.
BACKGROUND_INBOX_ENABLED=false
AUTO_REPLY_ENABLED=false
AUTO_REPLY_DRY_RUN=true
# When enabled, the LLM only rewrites AUTO_REPLY_BODY; it does not decide who receives a reply.
AUTO_REPLY_REWRITE_ENABLED=false
AUTO_REPLY_POLL_SECONDS=60
AUTO_REPLY_MAX_PER_HOUR=10
AUTO_REPLY_BODY=Thank you for your email. I have received your message and will connect with you shortly.

SENDER_NAME=Yash Sheth
